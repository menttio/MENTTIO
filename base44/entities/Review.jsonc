{
  "name": "Review",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "ID del profesor"
    },
    "teacher_name": {
      "type": "string",
      "description": "Nombre del profesor"
    },
    "student_id": {
      "type": "string",
      "description": "ID del alumno que la escribio (vacio en las recogidas por formulario)"
    },
    "student_name": {
      "type": "string",
      "description": "Nombre a mostrar. Nunca el nombre completo: solo el nombre de pila, o el curso o la edad en las anonimas. Esta entidad se lee en publico y muchos alumnos son menores."
    },
    "booking_id": {
      "type": "string",
      "description": "ID de la clase relacionada"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Valoración de 1 a 5 estrellas. Vacío si el alumno no puntuó: no se inventa"
    },
    "comment": {
      "type": "string",
      "description": "Comentario o reseña"
    },
    "source": {
      "type": "string",
      "enum": [
        "plataforma",
        "invitacion",
        "formulario"
      ],
      "default": "plataforma",
      "description": "De donde sale y cuanto se puede comprobar. plataforma: alumno registrado que dio la clase en Menttio. invitacion: alumno registrado invitado por su profesor, clase fuera de la plataforma. formulario: recogida a mano, sin comprobar; solo la crea un administrador."
    },
    "collected_at": {
      "type": "string",
      "description": "Fecha real en que el alumno la escribió (AAAA-MM-DD), que no tiene por qué ser la de alta"
    },
    "consent_note": {
      "type": "string",
      "description": "Qué autorizó exactamente el alumno al darla"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Aclaración en texto libre sobre esta reseña"
    }
  },
  "required": [
    "teacher_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
