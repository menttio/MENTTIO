{
  "name": "RateLimit",
  "type": "object",
  "properties": {
    "ip_hash": {
      "type": "string",
      "description": "Huella an\u00f3nima e irreversible (SHA-256) de la IP"
    },
    "kind": {
      "type": "string",
      "enum": [
        "contacto",
        "asistente"
      ],
      "default": "contacto",
      "description": "Acci\u00f3n limitada"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Aclaraci\u00f3n en texto libre sobre este registro"
    }
  },
  "required": [
    "ip_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}