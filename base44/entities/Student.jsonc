{
  "name": "Student",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del usuario asociado"
    },
    "full_name": {
      "type": "string",
      "description": "Nombre completo del alumno"
    },
    "profile_photo": {
      "type": "string",
      "description": "URL de la foto de perfil"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento (para saber si es menor de 14 a\u00f1os)"
    },
    "is_minor": {
      "type": "boolean",
      "description": "Si es menor de 14 a\u00f1os: el consentimiento lo da su padre, madre o tutor"
    },
    "guardian_name": {
      "type": "string",
      "description": "Nombre del padre, madre o tutor legal"
    },
    "guardian_email": {
      "type": "string",
      "description": "Email del padre, madre o tutor legal"
    },
    "guardian_relationship": {
      "type": "string",
      "enum": [
        "madre",
        "padre",
        "tutor"
      ],
      "description": "Relaci\u00f3n del adulto con el alumno"
    },
    "data_consent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se acept\u00f3 la pol\u00edtica de privacidad"
    },
    "consent_version": {
      "type": "string",
      "description": "Versi\u00f3n del texto de consentimiento aceptado"
    },
    "recording_consent": {
      "type": "boolean",
      "default": false,
      "description": "Autoriza la grabaci\u00f3n de sus clases (revocable)"
    },
    "recording_consent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la \u00faltima decisi\u00f3n sobre la grabaci\u00f3n"
    },
    "assigned_teachers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "teacher_id": {
            "type": "string"
          },
          "teacher_name": {
            "type": "string"
          },
          "subject_id": {
            "type": "string"
          },
          "subject_name": {
            "type": "string"
          }
        }
      },
      "description": "Profesores asignados al alumno"
    },
    "google_calendar_connected": {
      "type": "boolean",
      "default": false,
      "description": "Si tiene Google Calendar conectado"
    },
    "google_calendar_tokens": {
      "type": "object",
      "description": "Tokens de acceso de Google Calendar"
    }
  },
  "required": [
    "user_email",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}