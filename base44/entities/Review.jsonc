{
  "name": "Review",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "ID del profesor"
    },
    "teacher_name": {
      "type": "string",
      "description": "Nombre del profesor"
    },
    "student_id": {
      "type": "string",
      "description": "ID del alumno (vac\u00edo en las recogidas por formulario)"
    },
    "student_name": {
      "type": "string",
      "description": "Nombre a mostrar. En las an\u00f3nimas va el curso o la edad, nunca el nombre"
    },
    "booking_id": {
      "type": "string",
      "description": "ID de la clase relacionada"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Valoraci\u00f3n de 1 a 5 estrellas. Vac\u00edo si el alumno no puntu\u00f3: no se inventa"
    },
    "comment": {
      "type": "string",
      "description": "Comentario o rese\u00f1a"
    },
    "source": {
      "type": "string",
      "enum": [
        "plataforma",
        "formulario"
      ],
      "default": "plataforma",
      "description": "De d\u00f3nde sali\u00f3: dejada en la app, o recogida en un formulario aparte"
    },
    "collected_at": {
      "type": "string",
      "description": "Fecha real en que el alumno la escribi\u00f3 (AAAA-MM-DD), que no tiene por qu\u00e9 ser la de alta"
    },
    "consent_note": {
      "type": "string",
      "description": "Qu\u00e9 autoriz\u00f3 exactamente el alumno al darla"
    }
  },
  "required": [
    "teacher_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}