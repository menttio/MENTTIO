{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID de la conversaci\u00f3n"
    },
    "student_email": {
      "type": "string",
      "description": "Email del alumno de la conversaci\u00f3n (control de acceso)"
    },
    "teacher_email": {
      "type": "string",
      "description": "Email del profesor de la conversaci\u00f3n (control de acceso)"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "student",
        "teacher"
      ],
      "description": "Tipo de remitente"
    },
    "sender_id": {
      "type": "string",
      "description": "ID del remitente"
    },
    "sender_name": {
      "type": "string",
      "description": "Nombre del remitente"
    },
    "content": {
      "type": "string",
      "description": "Contenido del mensaje"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Si el mensaje ha sido le\u00eddo"
    }
  },
  "required": [
    "conversation_id",
    "sender_type",
    "sender_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.teacher_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}