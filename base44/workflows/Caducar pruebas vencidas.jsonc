{
  "name": "Caducar pruebas vencidas",
  "description": "Cada dia marca como terminadas las pruebas gratuitas cuya fecha de fin ya paso. Sin esto, un profesor que se registra y no vuelve a entrar se queda en trial_active para siempre, porque la caducidad solo se calculaba al abrir su perfil.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "caducar_pruebas_vencidas",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireStaleTrials",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}